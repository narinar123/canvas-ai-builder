# Optional: live AI generation. Without it, the builder uses its polished demo agent.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Optional: send builder workflow events to n8n.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Optional: let the Publish control create Vercel deployments.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_DEPLOY_HOOK_URL=
